[Unit]
Description=Liverpool Raspberry Pi 5 Gemini Live Robotics Agent
After=network-online.target sound.target
Wants=network-online.target sound.target

[Service]
Type=simple
User=ri
WorkingDirectory=/home/ri
EnvironmentFile=/home/ri/.env
ExecStart=/home/ri/run.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
