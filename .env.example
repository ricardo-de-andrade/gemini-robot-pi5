# Liverpool Robot Environment Configuration
# Copy this file to .env and insert your Gemini API key:
#   cp .env.example .env

GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model and Voice Selection
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE_NAME=Aoede   # Options: Aoede (jovial female), Puck, Charon, Kore, Fenrir

# Motor Direction Inversion Overrides (Default: left_arm=true for mirror mounting)
# MOTOR_INVERT_LEFT_ARM=true
# MOTOR_INVERT_RIGHT_ARM=false
# MOTOR_INVERT_HEAD=false
# MOTOR_INVERT_BODY=false

# Audio Device Overrides (Optional - hardware signatures are auto-detected dynamically)
# MIC_DEVICE_INDEX=
# SPEAKER_DEVICE_INDEX=
